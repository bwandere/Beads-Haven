# Environment Configuration for Beads Haven
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/beads_haven?sslmode=disable

# JWT Secret for admin authentication. Required in production.
# Outside DEV=true, the server fails fast if JWT_SECRET is unset.
# Set DEV=true to permit local development with fallback secret.
JWT_SECRET=beads-haven-production-secret-token-key-2026
DEV=true

# Cloudinary Image Upload (Optional; falls back to local storage in frontend/assets/uploads/ if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
